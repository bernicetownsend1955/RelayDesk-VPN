<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RelayDesk.Workspace" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontSize="14" Tag="layout-v3">
 <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="248" />
   <ColumnDefinition Width="28" />
   <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="18,24,18,20">
  <DockPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
    <TextBlock Text="Оформление" Style="{StaticResource Caption}" Margin="0,0,0,6" />
    <ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged" />
   </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
   <DockPanel MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <StackPanel DockPanel.Dock="Top">
     <DockPanel Margin="8,0,0,0">
      <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource Action}" Margin="0,0,10,0" DockPanel.Dock="Left"><Path Data="M7,7 L7,23 M7,7 L17,7 C23,7 23,16 17,16 L7,16 M15,16 L23,24" Stroke="White" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/></Border>
      <TextBlock Text="RelayDesk" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
     </DockPanel>
     <TextBlock Text="Управление подключением" Style="{StaticResource Caption}" Margin="8,8,0,22" />
     <ListBox SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}" Margin="0,0,0,10" x:Name="Navigation">
      <ListBoxItem AutomationProperties.Name="Панель" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M2,2 L8,2 L8,8 L2,8 Z M12,2 L18,2 L18,8 L12,8 Z M2,12 L8,12 L8,18 L2,18 Z M12,12 L18,12 L18,18 L12,18 Z" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Панель" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Настройки" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M2,5 L18,5 M2,15 L18,15 M6,2 L6,8 M14,12 L14,18" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Настройки" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Конфигурация" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M7,3 L2,10 L7,17 M13,3 L18,10 L13,17" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Конфигурация" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Ядра" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M3,3 L17,3 L17,17 L3,17 Z M7,7 L13,7 L13,13 L7,13 Z" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Ядра" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Автоматика" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M3,5 L16,5 L12,1 M17,15 L4,15 L8,19" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Автоматика" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Импорт приложений" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M10,2 L10,13 M5,8 L10,13 L15,8 M3,15 L3,18 L17,18 L17,15" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Импорт приложений" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Обновления" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M3,7 A7,7 0 1 1 3,14 M3,2 L3,7 L8,7" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Обновления" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Соединения" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal">
        <Path Data="M2,5 L8,5 L8,11 L2,11 Z M12,9 L18,9 L18,15 L12,15 Z M8,8 L12,12" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
        <TextBlock Text="Соединения" VerticalAlignment="Center" />
       </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="Профили" Padding="12,6" Margin="0,0,0,1">
       <StackPanel Orientation="Horizontal"><Path Data="M2,3 L18,3 L18,8 L2,8 Z M2,12 L18,12 L18,17 L2,17 Z M5,5 L7,5 M5,14 L7,14" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="Профили" VerticalAlignment="Center"/></StackPanel>
      </ListBoxItem>
     </ListBox>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,20,8,0">
     <TextBlock Text="Выбранный профиль" Style="{StaticResource Caption}" />
     <TextBlock x:Name="SidebarProfileName" Text="Нет профиля" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
     <TextBlock x:Name="SidebarProfileGroup" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    </StackPanel>
    <Border />
   </DockPanel>
  </ScrollViewer>
  </DockPanel>
  </Border>
  <Grid Grid.Column="2" x:Name="ContentGrid" Margin="0,28,28,20">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="8" />
    <RowDefinition Height="140" />
   </Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,24">
    <Button Content="Остановить всё" DockPanel.Dock="Right" Click="StopAllClick" VerticalAlignment="Top" Style="{StaticResource QuietButton}" />
    <StackPanel>
     <TextBlock Text="Панель" FontSize="28" FontWeight="SemiBold" x:Name="PageTitle" />
     <TextBlock x:Name="OverallStatus" Text="Процессы не запущены" Style="{StaticResource Caption}" Margin="0,6,0,0" />
    </StackPanel>
   </DockPanel>
   <StackPanel Grid.Row="1">
   <Border x:Name="AppReleaseBanner" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Selected}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
    <DockPanel>
     <Button x:Name="InstallAppBannerButton" Content="Установить" Click="InstallAppClick" DockPanel.Dock="Right" Margin="14,0,0,0" Style="{StaticResource Primary}" VerticalAlignment="Center" />
     <StackPanel><TextBlock x:Name="AppReleaseTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="AppReleaseSummary" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
   </Border>
   <Border x:Name="UpdateBanner" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Selected}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
    <DockPanel>
     <Button Content="Посмотреть обновления" Click="OpenUpdatesClick" DockPanel.Dock="Right" Padding="10,6" />
     <TextBlock x:Name="UpdateNotice" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
   </Border>
   </StackPanel>
   <TabControl x:Name="Tabs" Grid.Row="2" SelectionChanged="MainTabChanged" Style="{StaticResource WorkspaceTabs}">
    <TabItem Header="Панель">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border x:Name="SetupBanner" Style="{StaticResource Panel}" Margin="0,0,0,16" Visibility="Collapsed">
        <DockPanel>
         <Button Content="Настроить ядра" Click="SetupComponentsClick" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Primary}" Margin="20,0,0,0" />
         <StackPanel><TextBlock Text="Установи компоненты подключения" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="sing-box для VPN и Flowseal для zapret. Загрузка — после подтверждения." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
        </DockPanel>
       </Border>
       <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="20,16">
        <DockPanel>
        <Button Content="Сменить профиль" Click="OpenProfileLibrary" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Margin="16,0,0,0"/>
        <StackPanel>
         <TextBlock Text="Текущий профиль" Style="{StaticResource Caption}" Margin="0,0,0,6" />
         <TextBlock x:Name="ServerTitle" Text="Выбери профиль" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
         <TextBlock x:Name="ServerDescription" Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>
        </DockPanel>
       </Border>
       <Grid Margin="0,16,0,18">
        <Grid.ColumnDefinitions>
         <ColumnDefinition />
         <ColumnDefinition Width="16" />
         <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}" Padding="16">
         <StackPanel HorizontalAlignment="Stretch">
          <TextBlock Text="Обход DPI" Style="{StaticResource Caption}" Margin="0,0,0,10" />
          <Button x:Name="StartZapretButton" Click="ToggleZapretClick" Style="{StaticResource ConnectionPower}" AutomationProperties.Name="zapret">
           <StackPanel Orientation="Horizontal">
            <Path Data="M 12,2 L 12,12 M 6,5 A 9,9 0 1 0 18,5" Width="20" Height="22" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,14,0" />
            <TextBlock Text="zapret" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
           </StackPanel>
          </Button>
          <TextBlock x:Name="ZapretState" Text="Остановлен" Margin="0,12,0,4" />
          <TextBlock x:Name="ZapretAction" Text="Нажми, чтобы включить" Style="{StaticResource Caption}" />
          <Button Content="Настроить zapret" Click="OpenZapretSettings" Margin="0,10,0,0" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Grid.Column="2" Padding="16">
         <StackPanel HorizontalAlignment="Stretch">
          <TextBlock Text="Прокси / TUN" Style="{StaticResource Caption}" Margin="0,0,0,10" />
          <Button x:Name="ConnectButton" Click="ToggleVpnClick" Style="{StaticResource ConnectionPower}" AutomationProperties.Name="VPN">
           <StackPanel Orientation="Horizontal">
            <Path Data="M 12,2 L 21,6 L 21,13 C 21,19 16,23 12,25 C 8,23 3,19 3,13 L 3,6 Z" Width="20" Height="24" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,14,0" />
            <TextBlock Text="VPN" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
           </StackPanel>
          </Button>
          <TextBlock x:Name="ProxyState" Text="Отключено" Margin="0,12,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="VpnAction" Text="Нажми, чтобы включить" Style="{StaticResource Caption}" />
          <Button x:Name="EnableProfileProxy" Content="Включить системный прокси" Click="EnableProfileProxyClick" Visibility="Collapsed" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
          <Button Content="Настроить VPN" Click="OpenVpnSettings" Margin="0,10,0,0" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
         </StackPanel>
        </Border>
       </Grid>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,8" Margin="0,4,0,0">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="20" />
          <ColumnDefinition />
         </Grid.ColumnDefinitions>
         <DockPanel>
          <Button x:Name="TcpButton" Content="Проверить TCP" Click="TcpClick" DockPanel.Dock="Right" Padding="10,8" />
          <StackPanel>
           <TextBlock Text="TCP до сервера" />
           <TextBlock x:Name="TcpResult" Text="Не проверено" Style="{StaticResource Caption}" Margin="0,6,8,0" />
          </StackPanel>
         </DockPanel>
         <DockPanel Grid.Column="2">
          <Button x:Name="HttpsButton" Content="Проверить HTTPS" Click="HttpsClick" DockPanel.Dock="Right" Padding="10,8" />
          <StackPanel>
           <TextBlock Text="HTTPS через прокси" />
           <TextBlock x:Name="HttpsResult" Text="Не проверено" Style="{StaticResource Caption}" Margin="0,6,8,0" />
          </StackPanel>
         </DockPanel>
        </Grid>
       </Border>
       <TextBlock x:Name="ActionMessage" Margin="0,14,0,10">
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
          <Style.Triggers>
           <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
           </Trigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Настройки">
     <DockPanel LastChildFill="True" Margin="0,12,0,0">
      <TextBlock Text="Параметры выбранного профиля" FontSize="13" Foreground="{DynamicResource Muted}" DockPanel.Dock="Top" />
      <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
       <WrapPanel Margin="0,22,0,0">
        <Button Content="Сохранить настройки" Click="SaveClick" Style="{StaticResource Primary}" />
        <Button Content="Удалить профиль" Click="DeleteClick" Margin="8,0,0,0" />
       </WrapPanel>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,12,14,0">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
         <StackPanel>
          <TextBlock Text="Профиль" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="18" />
            <ColumnDefinition />
           </Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Название" Style="{StaticResource Label}" />
            <TextBox x:Name="ProfileName" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="Ядро" Style="{StaticResource Label}" />
            <ComboBox x:Name="CoreChoice" />
           </StackPanel>
          </Grid>
          <TextBlock x:Name="SettingsHint" Style="{StaticResource Caption}" Margin="0,12,0,0" />
         </StackPanel>
        </Border>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
         <StackPanel>
          <TextBlock Text="Подключение" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
          <CheckBox x:Name="AutoCandidate" Content="Участвует в автоматическом выборе сервера" />
          <Border Background="{DynamicResource Page}" BorderThickness="0" CornerRadius="6" Padding="14" Margin="0,14,0,8">
           <StackPanel>
            <CheckBox x:Name="Tun" Content="TUN: подключать приложения без настройки прокси" Style="{StaticResource Switch}" Margin="0" Click="TunModeChanged" />
            <TextBlock Text="Виртуальный сетевой адаптер перехватывает трафик приложений. Правила профиля определяют, что идёт через VPN, а что напрямую. Нужны права администратора." Style="{StaticResource Caption}" Margin="0,8,0,0" />
            <TextBlock x:Name="TunModeHint" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            <Button x:Name="EditTunJson" Content="Настроить TUN в JSON" Click="EditTunJsonClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" Visibility="Collapsed" />
           </StackPanel>
          </Border>
          <StackPanel x:Name="ManagedFields">
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition />
             <ColumnDefinition Width="16" />
             <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="DNS / IP-адрес" Style="{StaticResource Label}" />
             <TextBox x:Name="Dns" />
            </StackPanel>
            <StackPanel Grid.Column="2">
             <TextBlock Text="Локальный порт HTTP / SOCKS" Style="{StaticResource Label}" />
             <TextBox x:Name="LocalPort" />
            </StackPanel>
           </Grid>
          </StackPanel>
          <StackPanel x:Name="RawFields">
           <TextBlock Text="Локальный вход для HTTPS и системного прокси" Style="{StaticResource Label}" />
           <TextBox x:Name="ProxyAddress" />
           <TextBlock Text="Адрес должен совпадать с HTTP / SOCKS5-входом в конфигурации. Для системного прокси нужен HTTP." Style="{StaticResource Caption}" Margin="0,6,0,0" />
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition />
             <ColumnDefinition Width="16" />
             <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="Сервер для TCP (если в конфигурации несколько)" Style="{StaticResource Label}" />
             <TextBox x:Name="TcpHost" />
            </StackPanel>
            <StackPanel Grid.Column="2">
             <TextBlock Text="Порт TCP" Style="{StaticResource Label}" />
             <TextBox x:Name="TcpPort" />
            </StackPanel>
           </Grid>
          </StackPanel>
          <CheckBox x:Name="SystemProxy" Content="Включать системный HTTP-прокси при подключении" />
          <TextBlock Text="Прежние настройки восстанавливаются при отключении и закрытии программы." Style="{StaticResource Caption}" Margin="0,6,0,0" />
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
         <StackPanel>
          <TextBlock Text="Запуск вместе с Windows" FontSize="17" FontWeight="SemiBold"/>
          <CheckBox x:Name="WindowsStartupToggle" Content="Запускать RelayDesk при входе в Windows" Style="{StaticResource Switch}"/>
          <CheckBox x:Name="StartupVpnToggle" Content="Автоматически включать VPN"/>
          <CheckBox x:Name="StartupZapretToggle" Content="Автоматически включать zapret"/>
          <TextBlock Text="Профиль VPN для автозапуска" Style="{StaticResource Label}"/>
          <ComboBox x:Name="StartupProfileChoice"/>
          <TextBlock Text="Запуск через 15 секунд после входа в твою учётную запись, с правами администратора. Пароль не сохраняется. Подключение — после появления сети, по сохранённой стратегии. Автовыбор сервера учитывается, если включён." Style="{StaticResource Caption}" Margin="0,10,0,12"/>
          <Button Content="Сохранить автозапуск" Click="SaveStartupClick" HorizontalAlignment="Left"/>
          <TextBlock x:Name="StartupStatus" Text="Автозапуск выключен." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
         <StackPanel>
          <TextBlock Text="Экспериментальные функции" FontSize="17" FontWeight="SemiBold" />
          <CheckBox x:Name="ExperimentalFeatures" Content="Включить диагностику и запрос исправлений" Checked="ExperimentalFeaturesClick" Unchecked="ExperimentalFeaturesClick" Style="{StaticResource Switch}" />
          <TextBlock Text="Открывает настройки ВДС, отправку журналов и запрос исправлений. По умолчанию выключено. Локальный журнал работает независимо." Style="{StaticResource Caption}" Margin="0,8,0,0" />
         </StackPanel>
        </Border>
        <Expander x:Name="ExperimentalDiagnostics" Header="Диагностика и исправления" Visibility="Collapsed" Margin="0,0,0,14">
         <StackPanel Margin="0,14,0,0">
          <TextBlock Text="Журналы и исправления" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="Журнал хранится 14 дней, до 4 МБ в сутки. Перед записью скрываются известные форматы ссылок, паролей и ключей. Профили и JSON не отправляются. Произвольный текст ошибки может содержать другие личные данные." Style="{StaticResource Caption}" Margin="0,8,0,16" />
          <StackPanel Margin="0,10,0,0">
           <TextBlock x:Name="SupportStatus" Text="Подключение к ВДС ещё не настроено. Провайдер нейросети будет выбран отдельно." TextWrapping="Wrap" />
          </StackPanel>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Сервер и отправка журналов" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="IP ВДС" />
            <TextBox x:Name="SupportHost" Margin="0,6,0,12" />
            <TextBlock Text="Токен сервера (хранится под защитой учётной записи Windows)" />
            <PasswordBox x:Name="SupportToken" Margin="0,6,0,12" Padding="8" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1" />
            <CheckBox x:Name="AutoSupport" Content="Отправлять журнал каждые 15 минут через SSH" />
            <TextBlock Text="SSH использует твой ключ Windows и проверяет известный ключ ВДС. Сервер доступен через туннель, открывать публичный порт не требуется." Style="{StaticResource Caption}" Margin="0,8,0,12" />
            <WrapPanel>
             <Button Content="Сохранить" Click="SupportSave" />
             <Button Content="Отправить журнал" Click="SendSupport" Margin="8,0,0,0" />
            </WrapPanel>
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Запрос исправления" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="Что нужно исправить" Margin="0,24,0,6" />
            <TextBox x:Name="SupportIssue" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12,0,12">
             <Button Content="Запросить исправление" Click="RequestRepair" />
             <Button Content="Проверить статус" Click="CheckRepair" Margin="8,0,0,0" />
             <Button x:Name="DownloadRepairButton" Content="Скачать сборку" Click="DownloadRepair" IsEnabled="False" Margin="8,0,0,0" />
            </WrapPanel>
           </StackPanel>
          </Border>
         </StackPanel>
        </Expander>
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </TabItem>
    <TabItem Header="Конфигурация">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition />
       <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="Конфигурация" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,8" />
       <TextBlock x:Name="ConfigHint" Style="{StaticResource Caption}" Margin="0,0,0,12" />
      </StackPanel>
      <TextBox x:Name="ConfigEditor" Grid.Row="1" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      <WrapPanel Grid.Row="2" Margin="0,12,0,0">
       <Button Content="Сохранить JSON / текст" Click="SaveConfigClick" />
       <Button x:Name="CheckButton" Content="Проверить ядром" Click="CheckClick" Margin="8,0,0,0" />
       <Button Content="Экспортировать" Click="ExportClick" Margin="8,0,0,0" />
      </WrapPanel>
     </Grid>
    </TabItem>
    <TabItem Header="Ядра">
     <DockPanel LastChildFill="True" Margin="0,12,0,0">
      <TextBlock Text="Исполняемые файлы" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Top" />
      <TextBlock Text="Выбери EXE в распакованном дистрибутиве ядра. Зависимости оставь рядом с ним." Style="{StaticResource Caption}" Margin="0,8,0,0" DockPanel.Dock="Top" />
      <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
       <Button Content="Сохранить пути и стратегию" Click="SaveEnginesClick" HorizontalAlignment="Left" Margin="0,18,0,0" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,12,14,0">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
         <StackPanel>
          <TextBlock Text="VPN / sing-box" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Text="sing-box (для импорта ссылок — 1.12 или новее)" Style="{StaticResource Label}" />
          <DockPanel>
           <Button Content="Выбрать" Click="BrowseSing" DockPanel.Dock="Right" Margin="8,0,0,0" />
           <TextBox x:Name="SingExe" />
          </DockPanel>
         </StackPanel>
        </Border>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
         <StackPanel>
          <TextBlock Text="zapret / winws" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Text="zapret / winws.exe" Style="{StaticResource Label}" />
          <DockPanel>
           <Button Content="Выбрать" Click="BrowseZapret" DockPanel.Dock="Right" Margin="8,0,0,0" />
           <TextBox x:Name="ZapretExe" />
          </DockPanel>
          <TextBlock Text="Стратегия winws: один аргумент на строку" Style="{StaticResource Label}" />
          <Expander Header="Аргументы winws вручную" IsExpanded="False" Margin="0,12,0,0" Foreground="{DynamicResource Ink}">
           <TextBox x:Name="ZapretArgs" Height="150" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" />
          </Expander>
          <TextBlock Text="Без BAT-команд и внешних кавычек. Относительные пути считаются от папки EXE. Не направляй один поток одновременно в конфликтующие правила TUN и WinDivert." Style="{StaticResource Caption}" Margin="0,8,0,0" />
         </StackPanel>
        </Border>
        <Expander Header="Дополнительные ядра: Xray и mihomo" IsExpanded="False" Margin="0,0,0,14">
         <StackPanel Margin="0,12,0,0">
          <TextBlock Text="Xray" Style="{StaticResource Label}" />
          <DockPanel>
           <Button Content="Выбрать" Click="BrowseXray" DockPanel.Dock="Right" Margin="8,0,0,0" />
           <TextBox x:Name="XrayExe" />
          </DockPanel>
          <TextBlock Text="mihomo" Style="{StaticResource Label}" />
          <DockPanel>
           <Button Content="Выбрать" Click="BrowseMihomo" DockPanel.Dock="Right" Margin="8,0,0,0" />
           <TextBox x:Name="MihomoExe" />
          </DockPanel>
         </StackPanel>
        </Expander>
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </TabItem>
    <TabItem Header="Автоматика">
     <DockPanel>
      <TextBlock Text="Выбор сервера и разделение трафика" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Top" />
      <StackPanel DockPanel.Dock="Bottom">
       <WrapPanel Margin="0,18,0,12">
        <Button Content="Сохранить автоматику" Click="SaveAutomationClick" Style="{StaticResource Primary}" />
        <Button Content="Проверить Discord" Click="AuditDiscordClick" Margin="8,0,0,0" />
        <Button Content="Проверить серверы" Click="MeasureServersClick" Margin="8,0,0,0" />
        <Button Content="Отменить проверку" Click="CancelAutomationClick" Margin="8,0,0,0" />
       </WrapPanel>
       <TextBlock x:Name="AutomationStatus" Style="{StaticResource Caption}" Text="Проверки не выполнялись." />
       <ListBox x:Name="AutomationResults" MaxHeight="280" Margin="0,12,0,0" />
      </StackPanel>
      <TabControl x:Name="AutomationTabs">
       <TabItem Header="Маршруты">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="0,14,14,0">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Автоматический режим" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <CheckBox x:Name="ConditionalRouting" Content="Менять правила по состоянию VPN и zapret" Click="ConditionalRoutingChanged" />
            <TextBlock Text="Только zapret — без ограничения приложениями и доменами; VPN + zapret — Discord и выбранные EXE напрямую, остальное по профилю; только VPN — исходный профиль. Переключение перезапускает процессы и может прервать соединения. Обработка zapret зависит от протокола и стратегии." Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <CheckBox x:Name="WithZapret" Content="Запускать zapret вместе с VPN" />
            <TextBlock Text="Без этого флажка две кнопки работают независимо. Отключение VPN оставляет zapret включённым." Style="{StaticResource Caption}" Margin="0,6,0,0" />
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Ручные правила" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock x:Name="RoutingControlsHint" Style="{StaticResource Caption}" Margin="0,12,0,8" />
            <Button x:Name="ManualRoutingButton" Content="Перейти к ручной настройке" Click="ManualRoutingClick" HorizontalAlignment="Left" Margin="0,0,0,8" />
            <CheckBox x:Name="DiscordSplit" Content="Discord — напрямую с zapret, остальное — через VPN" />
            <TextBlock Text="Режим включает TUN при подключении профиля из ссылки. Процессы Discord и его домены идут напрямую; фильтры zapret задаются ниже. Нужны права администратора." Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <CheckBox x:Name="DiscordOnly" Content="Ограничить zapret доменами Discord и указанными IP голоса" />
            <TextBlock Text="Выбранные приложения: обходить VPN по полному пути EXE" Style="{StaticResource Label}" />
            <ListBox x:Name="ApplicationList" Height="100" BorderBrush="{DynamicResource Line}" BorderThickness="1" />
            <WrapPanel Margin="0,8,0,0">
             <Button Content="Добавить EXE" Click="AddApplicationClick" />
             <Button Content="Убрать выбранное" Click="RemoveApplicationClick" Margin="8,0,0,0" />
            </WrapPanel>
            <TextBlock Text="Эти правила выводят приложения из VPN при включённом разделении. Они не привязывают winws к EXE: zapret по-прежнему ограничен доменами/IP. Строгая фильтрация zapret по процессам пока не реализована." Style="{StaticResource Caption}" Margin="0,8,0,0" />
           </StackPanel>
          </Border>
         </StackPanel>
        </ScrollViewer>
       </TabItem>
       <TabItem Header="Серверы">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="0,14,14,0">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Выбор при подключении" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <CheckBox x:Name="AutoServer" Content="При подключении выбирать сервер по HTTPS" />
            <TextBlock Text="Три запроса через каждый отмеченный сервер sing-box; нужны два ответа 2xx. Выбирается наименьшая медиана. После подключения сервер сам не меняется." Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <TextBlock Text="URL проверки HTTPS" Style="{StaticResource Label}" />
            <TextBox x:Name="TestUrl" />
           </StackPanel>
          </Border>
         </StackPanel>
        </ScrollViewer>
       </TabItem>
       <TabItem Header="Стратегии">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="0,14,14,0">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Подбор стратегии" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <CheckBox x:Name="AutoZapret" Content="Перед подключением проверять Discord и подбирать стратегию" />
            <TextBlock Text="Проверка использует обычный Ethernet/Wi-Fi для тестовых соединений. Рабочий VPN можно оставить включённым. Перед сравнением останови только zapret." Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <TextBlock Text="Стратегии: название, затем DPI-аргументы. Между стратегиями — строка ---" Style="{StaticResource Label}" />
            <Button Content="Загрузить TCP-стратегии Flowseal" Click="LoadFlowsealClick" HorizontalAlignment="Left" Margin="0,0,0,8" />
            <ComboBox x:Name="FlowsealChoice" DisplayMemberPath="Name" Margin="0,0,0,8" />
            <Button Content="Применить выбранную TCP-стратегию" Click="ApplyFlowsealClick" HorizontalAlignment="Left" Margin="0,0,0,8" />
            <Expander Header="Параметры стратегий (дополнительно)" IsExpanded="False" Margin="0,12,0,0" Foreground="{DynamicResource Ink}">
             <TextBox x:Name="StrategyList" Height="170" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" />
            </Expander>
           </StackPanel>
          </Border>
         </StackPanel>
        </ScrollViewer>
       </TabItem>
       <TabItem Header="Голос">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="0,14,14,0">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Голосовые адреса" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <CheckBox x:Name="VoiceUdpDesync" Content="Обрабатывать голосовой UDP в zapret" Margin="0,0,0,8" />
            <TextBlock Text="Выключи для сравнения при зависании DTLS. Голосовые UDP-профили не добавляются; маршруты приложений и адресов сохраняются. Сохрани автоматику и переподключи компоненты. QUIC на UDP 443 обрабатывается отдельно." Style="{StaticResource Caption}" Margin="0,0,0,12" />
            <TextBlock Text="IP / CIDR голосовых серверов Discord, по одному на строку" Style="{StaticResource Label}" />
            <TextBox x:Name="VoiceCidrs" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="Без этих IP zapret обрабатывает только TLS доменов Discord. Голосовые IP нельзя получить из HTTPS-пинга; укажи их из текущей сессии. Для указанных IP разрешены все UDP-порты, включая WebRTC 19326; Обрабатываются Discord/STUN и начальные пакеты других UDP-протоколов для этапа DTLS; число пакетов ограничено. Это фильтрация по трафику, не по имени приложения." Style="{StaticResource Caption}" Margin="0,6,0,0" />
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
           <StackPanel>
            <TextBlock Text="Проверка UDP" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="Браузер и Vesktop могут использовать WebRTC: этот тест для него не подходит. Оставь его выключенным. IP discovery проверяет только ответ UDP; передачу аудио он не подтверждает." Style="{StaticResource Caption}" Margin="0,16,0,0" />
            <CheckBox x:Name="VoiceDiscoveryEnabled" Content="Проверять UDP IP discovery (не WebRTC)" Margin="0,12,0,8" />
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="150" />
             </Grid.ColumnDefinitions>
             <StackPanel>
              <TextBlock Text="Голосовой endpoint / IP:порт" Style="{StaticResource Label}" />
              <TextBox x:Name="VoiceEndpoint" IsEnabled="{Binding IsChecked, ElementName=VoiceDiscoveryEnabled}" />
             </StackPanel>
             <StackPanel Grid.Column="2">
              <TextBlock Text="SSRC" Style="{StaticResource Label}" />
              <TextBox x:Name="VoiceSsrc" IsEnabled="{Binding IsChecked, ElementName=VoiceDiscoveryEnabled}" />
             </StackPanel>
            </Grid>
           </StackPanel>
          </Border>
         </StackPanel>
        </ScrollViewer>
       </TabItem>
       
   </TabControl>
     </DockPanel>
    </TabItem>
    <TabItem Header="Импорт приложений">
     <DockPanel LastChildFill="True" Margin="0,12,0,0">
      <TextBlock Text="NekoBox / NekoRay и v2rayN" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Top" />
      <TextBlock Text="Поиск читает известные папки приложений. Настройки исходных приложений не меняются. Пароли не выводятся в предпросмотре." Style="{StaticResource Caption}" Margin="0,8,0,0" DockPanel.Dock="Top" />
      <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
       <WrapPanel Margin="0,18,0,12">
        <Button Content="Найти источники" Click="FindSourcesClick" />
        <Button Content="Выбрать файл" Click="BrowseSourceClick" Margin="8,0,0,0" />
        <Button Content="Предпросмотр импорта" Click="PreviewSourceClick" Margin="8,0,0,0" />
        <Button Content="Обновить связанные" Click="RefreshImportsClick" Margin="8,0,0,0" />
       </WrapPanel>
       <TextBlock x:Name="ImportStatus" Style="{StaticResource Caption}" Margin="0,14,0,0" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,12,14,0">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
         <StackPanel>
          <TextBlock Text="Источники профилей" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Text="Дополнительная папка portable-приложения" Style="{StaticResource Label}" />
          <TextBox x:Name="ImportFolder" />
          <CheckBox x:Name="SyncImports" Content="Обновлять одобренные профили при запуске и перед подключением" />
         </StackPanel>
        </Border>
        <ListBox x:Name="ImportSources" MaxHeight="300" MinHeight="180">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <StackPanel>
            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
           </StackPanel>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="Поддержаны профили JSON NekoRay 4, guiNConfig.json старых v2rayN, таблица ProfileItem в guiNDB.db и экспорты ссылок TXT. Для LMDB/LevelDB новых NekoBox нужен экспорт ссылок в файл. Глобальные DNS, TUN и правила других приложений не переносятся без проверки совместимости." Style="{StaticResource Caption}" Margin="0,18,0,0" />
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </TabItem>
    <TabItem Header="Обновления">
     <DockPanel LastChildFill="True" Margin="0,12,0,0">
      <TextBlock Text="Обновления приложения и ядер" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Top" />
      <TextBlock Text="sing-box — ядро VPN. zapret / winws — обход DPI. NekoBox для работы RelayDesk не требуется." Style="{StaticResource Caption}" Margin="0,8,0,0" DockPanel.Dock="Top" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,12,14,0">
        <CheckBox x:Name="AutoUpdates" Content="Автоматически проверять, загружать и готовить обновления" Click="AutoUpdatesChanged" />
        <TextBlock Text="Источники закреплены. Новые версии скачиваются в фоне и проверяются по SHA-256. Ядра переключаются при следующем запуске; RelayDesk устанавливается при закрытии и запускается снова. Работающие подключения во время загрузки сохраняются." Style="{StaticResource Caption}" Margin="0,8,0,0" />
        <WrapPanel Margin="0,18,0,16">
         <Button x:Name="CheckUpdatesButton" Content="Проверить обновления" Click="CheckUpdatesClick" />
         <Button x:Name="InstallRequiredButton" Content="Установить недостающие ядра" Click="InstallRequiredComponentsClick" Margin="8,0,0,0" Style="{StaticResource Primary}" />
         <Button Content="Отменить загрузку" Click="CancelUpdatesClick" Margin="8,0,0,0" />
        </WrapPanel>
        <TextBlock x:Name="UpdatesStatus" Style="{StaticResource Caption}" Text="Проверка ещё не выполнялась." />
        <TextBlock x:Name="OtherUpdateStatus" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <Border Style="{StaticResource Panel}" Margin="0,14,0,16">
         <StackPanel>
          <TextBlock Text="RelayDesk" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="GitHub-репозиторий релизов" Style="{StaticResource Label}"/>
          <TextBox x:Name="AppRepository" IsReadOnly="True" ToolTip="Закреплённый источник RelayDesk"/>
          <TextBlock x:Name="AppUpdateStatus" Text="Версия не проверена" TextWrapping="Wrap" Margin="0,12,0,10"/>
          <StackPanel x:Name="AppNotesPanel" Visibility="Collapsed">
           <Expander Header="Что изменилось" IsExpanded="False"><TextBlock x:Name="AppReleaseNotes" TextWrapping="Wrap" Margin="0,12,0,12"/></Expander>
           <Button x:Name="InstallAppButton" Content="Установить RelayDesk" Click="InstallAppClick" IsEnabled="False" HorizontalAlignment="Left" Style="{StaticResource Primary}" Margin="0,12,0,0"/>
          </StackPanel>
          <TextBlock Text="Источник RelayDesk нельзя изменить. Подтверждение в приложении не требуется; Windows может показать системный запрос прав администратора. Профили сохраняются." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
         </StackPanel>
        </Border>
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="14" />
          <ColumnDefinition />
         </Grid.ColumnDefinitions>
         <Border Style="{StaticResource Panel}" Margin="0" Grid.Column="0">
          <StackPanel>
           <TextBlock Text="sing-box" FontSize="19" FontWeight="SemiBold" />
           <TextBlock x:Name="SingUpdateStatus" Text="Версия не проверена" TextWrapping="Wrap" Margin="0,10,0,14" />
           <WrapPanel>
            <Button x:Name="InstallSingButton" Content="Установить обновление" Click="InstallSingClick" IsEnabled="False" Style="{StaticResource Primary}" />
            <Button Content="Описание версии" Click="SingReleaseClick" Margin="8,0,0,0" />
            <Button Content="Вернуть прежнее ядро" Click="RollbackSingClick" Margin="8,0,0,0" />
           </WrapPanel>
          </StackPanel>
         </Border>
         <Border Style="{StaticResource Panel}" Margin="0" Grid.Column="2">
          <StackPanel>
           <TextBlock Text="zapret / winws" FontSize="19" FontWeight="SemiBold" />
           <TextBlock x:Name="ZapretUpdateStatus" Text="Сборка не проверена" TextWrapping="Wrap" Margin="0,10,0,14" />
           <WrapPanel>
            <Button x:Name="InstallZapretButton" Content="Установить обновление" Click="InstallZapretClick" IsEnabled="False" Style="{StaticResource Primary}" />
            <Button Content="Изменения сборки" Click="ZapretReleaseClick" Margin="8,0,0,0" />
            <Button Content="Вернуть прежний zapret" Click="RollbackZapretClick" Margin="8,0,0,0" />
           </WrapPanel>
          </StackPanel>
         </Border>
        </Grid>
        <TextBlock Text="Источники: SagerNet/sing-box и релизы Flowseal/zapret-discord-youtube на GitHub. Проверяется SHA-256 архивов. Для внешнего zapret версия Flowseal неизвестна: предлагается переход на выбранный релиз. BAT-скрипты не запускаются; параметры RelayDesk сохраняются." Style="{StaticResource Caption}" Margin="0,16,0,0" />
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </TabItem>
    <TabItem x:Name="ConnectionTab" Header="Соединения">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel>

       <TextBlock x:Name="ConnectionsHeading" Text="Маршруты соединений" FontSize="21" FontWeight="SemiBold" />
       <TextBlock Text="sing-box и mihomo показывают текущие соединения, Xray — историю выбранных выходов за 3 минуты. Область zapret показывает совпадение фильтра. Список хранится в памяти и не отправляется на ВДС." Style="{StaticResource Caption}" Margin="0,8,0,12" />
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,12">
       <CheckBox x:Name="PauseConnections" Content="Пауза" DockPanel.Dock="Right" Margin="12,0,0,0" />
       <TextBox x:Name="ConnectionFilter" TextChanged="ConnectionFilterChanged" ToolTip="Фильтр: Discord, vesktop, домен, маршрут" />
      </DockPanel>
      <StackPanel Grid.Row="2" Margin="0,0,0,12">
       <TextBlock x:Name="ConnectionsStatus" Text="Запусти sing-box, Xray или mihomo в RelayDesk." Style="{StaticResource Caption}"/>
       <TextBlock Text="Нажми на адрес, чтобы настроить маршрут. В sing-box также доступен выбор приложения. Сортировка сохраняется при обновлении списка." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
       <TextBlock x:Name="ConnectionActionStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
      <DataGrid x:Name="ConnectionsTable" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" RowBackground="{DynamicResource Surface}" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}">

       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Приложение" SortMemberPath="Application" Width="150">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Application}" IsEnabled="{Binding CanEditApplication}" Click="ConnectionAppClick" ToolTip="Настроить маршрут приложения" Style="{StaticResource ConnectionLink}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Назначение" SortMemberPath="Destination" Width="200">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Destination}" IsEnabled="{Binding CanEdit}" Click="ConnectionHostClick" ToolTip="Настроить маршрут домена или IP" Style="{StaticResource ConnectionLink}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Сеть" Binding="{Binding Network}" Width="50" />
        <DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Маршрут" Binding="{Binding Route}" Width="140" />
        <DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="zapret" Binding="{Binding Zapret}" Width="260" />
        <DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Выход" Binding="{Binding Outbound}" Width="100" />
        <DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Правило" Binding="{Binding Rule}" Width="250" />
        <DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Байты" Binding="{Binding Traffic}" SortMemberPath="TotalBytes" Width="140" />
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </TabItem>
    <TabItem Header="Профили" x:Name="ProfilesTab">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="Группы" Click="EditSubscriptionGroups" Margin="0,0,8,0"/>
         <Button Content="Обновить подписку" Click="OpenSubscriptions"/>
        </StackPanel>
        <Button Content="Добавить" Click="OpenProfileAddMenu" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
       </DockPanel>
       <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Группа" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="SubscriptionGroupFilter" SelectionChanged="SubscriptionGroupChanged" ToolTip="Группа подписок"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Поиск по названию, серверу или ядру" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="ProfileSearch" Height="36" Padding="10,0" VerticalContentAlignment="Center" TextChanged="ProfileSearchChanged" AutomationProperties.Name="Поиск профилей"/></StackPanel>
       </Grid>
              <Expander Header="Задержка серверов (TCP)" Margin="0,0,0,14">
        <StackPanel Margin="0,12,0,0">
         <WrapPanel><Button x:Name="StartServerPing" Content="Проверить серверы группы" Click="CheckServerLatency"/><Button x:Name="StopServerPing" Content="Отмена" Click="CancelServerPing" IsEnabled="False" Margin="8,0,0,0"/></WrapPanel>
         <TextBlock x:Name="ServerPingsStatus" Text="TCP-проверка серверов выбранной группы. VPN не переключается." Style="{StaticResource Caption}" Margin="0,8,0,8"/>
         <DataGrid x:Name="ServerPingsTable" Height="150" RowBackground="{DynamicResource Surface}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}">
          <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Профиль" Binding="{Binding Profile}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Ядро" Binding="{Binding Core}" Width="80"/><DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="Сервер" Binding="{Binding Server}" Width="200"/><DataGridTextColumn ElementStyle="{StaticResource ConnectionCell}" Header="TCP" Binding="{Binding Result}" SortMemberPath="Milliseconds" Width="180"/></DataGrid.Columns>
         </DataGrid>
        </StackPanel>
       </Expander>
       <DockPanel Margin="0,0,0,10"><Button Content="Открыть подключение" Click="OpenProfilesConnection" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"/><TextBlock x:Name="ProfileCount" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
      </StackPanel>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}" CornerRadius="6" Padding="8">
       <ListBox x:Name="ProfileList" SelectionChanged="ProfileSelected" ContextMenuOpening="ProfileContextMenuOpening" MouseDoubleClick="OpenProfilesConnection" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
        <ListBox.ItemTemplate><DataTemplate>
         <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Host}" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Core}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding SubscriptionGroup}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Border>
     </DockPanel>
    </TabItem>
   </TabControl>
   <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Line}" x:Name="LogSplitter" />
   <DockPanel Grid.Row="4">
    <DockPanel DockPanel.Dock="Top" Margin="0,8,0,8">
     <Button Content="Очистить" Click="ClearLog" DockPanel.Dock="Right" Padding="8,3" />
     <CheckBox Content="Журнал" Click="ShowLogClick" IsChecked="True" Margin="0" VerticalAlignment="Center" x:Name="ShowLog" />
    </DockPanel>
    <TextBox x:Name="Log" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
   </DockPanel>
  </Grid>
 </Grid>
</UserControl>
