      <Border x:Name="OrbitConnectionPage" Visibility="Collapsed" Background="#0C0C0C" Padding="36,28"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="Вернуться к планете" Click="BackToPanel" Style="{StaticResource Plain}" HorizontalAlignment="Left"/><TextBlock Text="Подключение" FontSize="28" FontWeight="SemiBold" Margin="0,18,0,22"/></StackPanel><ScrollViewer><StackPanel x:Name="OrbitConnectionBody"><Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Общий режим подключения" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="TUN, системный прокси и локальный порт действуют на все VPN и группы. Серверы, ключи и собственные DNS остаются в профилях." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><CheckBox x:Name="SharedTun" Content="TUN для всех профилей sing-box"/><CheckBox x:Name="SharedSystemProxy" Content="Системный прокси для всех профилей"/><TextBlock Text="Общий локальный порт" Style="{StaticResource MutedText}" Margin="0,12,0,6"/><TextBox x:Name="SharedPort" Width="140" HorizontalAlignment="Left"/><WrapPanel Margin="0,12,0,0"><Button Content="Сохранить общий режим" Click="SaveSharedConnection" Margin="0,0,8,0"/><Button Content="Настроить трафик выбранной подписки" Click="EnableSubscriptionTraffic"/></WrapPanel><TextBlock x:Name="SharedConnectionMessage" Style="{StaticResource MutedText}" Margin="0,12,0,0" Text="Сохранённый режим применяется при следующем подключении или по кнопке «Применить правила»."/></StackPanel></Border>
