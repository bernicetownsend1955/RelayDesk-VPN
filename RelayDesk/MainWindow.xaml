ext}" Margin="0,14,0,6"/><DockPanel><TextBlock x:Name="OverlaySharkOpacityLabel" DockPanel.Dock="Right" Width="55" TextAlignment="Right"/><Slider x:Name="OverlaySharkOpacity" AutomationProperties.Name="Яркость ASCII-фона оверлея" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OverlayChanged"/></DockPanel><TextBlock x:Name="OverlayMessage" Style="{StaticResource MutedText}" Margin="0,14,0,0" Text="Входящая скорость сверху, исходящая снизу; значения в Мбит/с. В sing-box и mihomo счётчики активных соединений опрашиваются дважды в секунду: короткие соединения между замерами могут быть пропущены."/></StackPanel></Border>
