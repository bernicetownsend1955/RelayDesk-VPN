<Window x:Class="RelayDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RelayDesk"
 Title="RelayDesk" WindowStyle="None" Width="1320" Height="920" MinWidth="1040" MinHeight="740" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="#ECEEF2" FontFamily="Segoe UI" FontSize="16" Loaded="Ready">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModernTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Grid><Grid.Clip><RectangleGeometry x:Name="WindowClip" Rect="0,0,1320,920" RadiusX="14" RadiusY="14"/></Grid.Clip>
  <local:AsciiSharksBackdrop x:Name="CityBackdrop" IsHitTestVisible="False"/>
  <Border x:Name="BackdropShade" Background="Transparent" IsHitTestVisible="False"/>
 <Border x:Name="Shell" Background="#4010141B" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="14">
  <Grid><Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Grid Margin="22,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <local:AnimatedBrandTitle x:Name="BrandTitle" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="VPN и zapret" Style="{StaticResource MutedText}" Margin="16,0" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
     <Button AutomationProperties.Name="Свернуть" ToolTip="Свернуть" Style="{StaticResource CaptionButton}" Click="Minimize"><Grid Width="14" Height="14"><Line X1="2" Y1="7" X2="12" Y2="7" Stroke="#ECEEF2" StrokeThickness="1.3"/></Grid></Button>
     <Button AutomationProperties.Name="Развернуть" ToolTip="Развернуть / восстановить" Style="{StaticResource CaptionButton}" Click="Maximize"><Grid Width="14" Height="14"><Rectangle Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#ECEEF2" StrokeThickness="1.3"/></Grid></Button>
     <Button AutomationProperties.Name="Закрыть RelayDesk" ToolTip="Закрыть" Style="{StaticResource CaptionButton}" Click="ClosePreview"><Grid Width="14" Height="14"><Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="#ECEEF2" StrokeThickness="1.3"/></Grid></Button>
    </StackPanel>
   </Grid>
   <Grid x:Name="StandardContent" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border BorderBrush="#24FFFFFF" BorderThickness="0,0,1,0" Background="#70101318" Padding="12,18,12,12"><DockPanel>
     <Button DockPanel.Dock="Bottom" Style="{StaticResource Nav}" Content="?    О программе" Click="Help"/>
     <StackPanel x:Name="Navigation">
      <Button x:Name="HomeNav" Style="{StaticResource Nav}" Content="⌂    Главная" Tag="0" Click="Navigate"/>
      <Button Style="{StaticResource Nav}" Content="≡    Профили" Tag="1" Click="Navigate"/>
      <Button Style="{StaticResource Nav}" Content="↔    Соединения" Tag="4" Click="Navigate"/>
      <Button Style="{StaticResource Nav}" Content="⊞    Приложения" Tag="2" Click="Navigate"/>
      <Button Style="{StaticResource Nav}" Content="⚙    Настройки" Tag="3" Click="Navigate"/>
     </StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="28,20,28,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel x:Name="AdvancedHost" Visibility="Collapsed">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><Button Content="Вернуться к панели" Click="BackToPanel" HorizontalAlignment="Left"/><TextBlock Text="Параметры профиля и программы" Style="{StaticResource Heading}" Margin="0,18,0,12"/><ComboBox x:Name="AdvancedSection" AutomationProperties.Name="Раздел параметров" SelectionChanged="AdvancedSectionChanged"/></StackPanel>
      <ContentControl x:Name="BackendHost"/>
     </DockPanel>
     <ScrollViewer x:Name="Scroller"><Grid x:Name="PageHost" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
      <Viewbox x:Name="HomeFrame" Height="{Binding ActualHeight,ElementName=Scroller}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top" Visibility="{Binding Visibility,ElementName=HomePage}">
      <StackPanel x:Name="HomePage" Width="1040">
       <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Подключение" Style="{StaticResource Heading}"/><TextBlock Text="VPN и zapret управляются отдельно" FontSize="17" Foreground="#C4C7CE"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Настройки" Click="OpenSettings"/></Grid>
       <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}"><StackPanel>
         <Grid Height="205"><StackPanel><TextBlock Text="VPN" FontSize="40" FontWeight="SemiBold"/><TextBlock x:Name="VpnStatus" Text="Выключен" Foreground="#9098A6" FontSize="17" Margin="0,6,0,0"/></StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="150"><Button x:Name="VpnPower" Style="{StaticResource Power}" AutomationProperties.Name="VPN" Width="98" Height="98" Padding="0" Click="ToggleVpn"><Grid><Ellipse x:Name="VpnRing" Width="90" Height="90" Stroke="#B6C2D4" StrokeThickness="1.5"/><Path x:Name="VpnGlyph" Data="M12,2 L12,11 M5.5,5.5 A9,9 0 1 0 18.5,5.5" Width="38" Height="42" Stretch="Uniform" Stroke="#E1E6EF" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button><Button x:Name="VpnActionButton" Margin="0,6,0,0" Padding="12,5" Click="ToggleVpn"><TextBlock x:Name="VpnAction" Text="Включить" FontSize="14" Foreground="#C4C7CE"/></Button></StackPanel>
         </Grid>
         <Border Height="1" Background="#30FFFFFF" Margin="0,10,0,14"/>
         <TextBlock Text="Сервер" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
         <ComboBox x:Name="ServerChoice" SelectionChanged="ServerChanged"/>
         <TextBlock x:Name="ServerHint" Text="Автовыбор при подключении" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
         <TextBlock x:Name="Latency" Text="TCP ещё не проверен" Foreground="#C9D1DE" Margin="0,20,0,0"/>
        </StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel>
         <Grid Height="205"><StackPanel><TextBlock Text="zapret" FontSize="40" FontWeight="SemiBold"/><TextBlock x:Name="ZapretStatus" Text="Выключен" Foreground="#9098A6" FontSize="17" Margin="0,6,0,0"/></StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="150"><Button x:Name="ZapretPower" Style="{StaticResource Power}" AutomationProperties.Name="zapret" Width="98" Height="98" Padding="0" Click="ToggleZapret"><Grid><Ellipse x:Name="ZapretRing" Width="90" Height="90" Stroke="#B6C2D4" StrokeThickness="1.5"/><Path x:Name="ZapretGlyph" Data="M12,2 L12,11 M5.5,5.5 A9,9 0 1 0 18.5,5.5" Width="38" Height="42" Stretch="Uniform" Stroke="#E1E6EF" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button><Button x:Name="ZapretActionButton" Margin="0,6,0,0" Padding="12,5" Click="ToggleZapret"><TextBlock x:Name="ZapretAction" Text="Включить" FontSize="14" Foreground="#C4C7CE"/></Button></StackPanel>
         </Grid>
         <Border Height="1" Background="#30FFFFFF" Margin="0,10,0,14"/>
         <TextBlock Text="Область применения" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
         <ComboBox x:Name="ScopeChoice" SelectionChanged="ScopeChanged"/>
         <TextBlock Text="Обходит ограничения без VPN" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
         <TextBlock x:Name="Strategy" Text="Стратегия из настроек" Foreground="#C9D1DE" Margin="0,20,0,0"/>
        </StackPanel></Border>
       </Grid>
       <Border Style="{StaticResource Panel}"><StackPanel>
        <TextBlock Text="Как идут подключения" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Выбери маршрут для приложения" FontSize="16" Foreground="#A2A8B4" Margin="0,5,0,18"/>
        <StackPanel x:Name="HomeRoutes"/>
        <TextBlock x:Name="RouteHint" Text="Для Discord оставлен VPN: прямое подключение может зависать." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
       </StackPanel></Border>
       <WrapPanel Margin="0,10,0,0"><Button Content="Проверить TCP" Click="CheckTcp" Margin="0,0,8,0"/><Button Content="Проверить HTTPS" Click="CheckHttps"/></WrapPanel><TextBlock x:Name="HttpsStatus" Style="{StaticResource MutedText}" Margin="0,6"/><Button Content="Журнал" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,8,0,0" Padding="0,8" FontSize="13" Click="ToggleJournal"/>
       <Border x:Name="JournalPanel" Visibility="Collapsed" Style="{StaticResource Panel}" Margin="0,4,0,0"><TextBlock x:Name="Journal" FontFamily="Consolas" FontSize="12" Foreground="#9098A6"/></Border>
      </StackPanel></Viewbox>
      <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
       <TextBlock Text="Профили" Style="{StaticResource Heading}"/><TextBlock Text="Профили и подписки из твоей конфигурации" Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
       <WrapPanel Margin="0,0,0,14"><Button Content="Добавить профиль / подписку" Click="ImportProfiles" Margin="0,0,10,0"/><Button Content="Управлять группами" Click="EditGroups"/></WrapPanel><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="GroupChoice" Width="240" HorizontalAlignment="Left" SelectionChanged="GroupChanged"/><Button Grid.Column="1" Content="Проверить задержку" Click="ProbeServers"/></Grid>
       <Border Style="{StaticResource Panel}"><StackPanel x:Name="ProfileRows"/></Border>
       <Border Style="{StaticResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Новая группа" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GroupName" AutomationProperties.Name="Название группы" ToolTip="Название группы"/><Button Grid.Column="1" Content="Добавить группу" Click="AddGroup" Margin="12,0,0,0"/></Grid><TextBlock Text="Создавай группы для сохранённых профилей; назначение групп доступно по кнопке «Управлять группами»." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="AppsPage" Visibility="Collapsed">
       <TextBlock Text="Приложения и сайты" Style="{StaticResource Heading}"/><TextBlock Text="Приложения, домены и IP — отдельными правилами" Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
       <WrapPanel Margin="0,0,0,14"><Button Content="Добавить приложение…" Click="AddApplication" Margin="0,0,10,8"/><Button Content="Добавить сайт / IP…" Click="AddSite" Margin="0,0,10,8"/><Button Content="Применить правила" Click="ApplyRules" Margin="0,0,10,8" ToolTip="Переподключит работающий выбранный профиль"/><Button x:Name="UndoRuleButton" Content="Отменить удаление" Click="UndoRule" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="RulesFilter" SelectionChanged="RulesFilterChanged"/><Grid Grid.Column="1" Margin="12,0,0,0"><TextBox x:Name="RuleSearch" TextChanged="RulesFilterChanged" ToolTip="Поиск по названию, домену или пути" AutomationProperties.Name="Поиск правил"/><TextBlock Text="Поиск по названию, домену или EXE" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#808998" FontSize="14"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=RuleSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
       <TextBlock x:Name="RulesCount" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
       <Border Style="{StaticResource Panel}" Padding="12"><StackPanel x:Name="AppRoutes"/></Border>
       <TextBlock x:Name="DiscoveryNotice" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
       <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="12"><StackPanel><TextBlock Text="Если ни одно правило не подошло" Style="{StaticResource MutedText}" Margin="10,2,0,10"/><StackPanel x:Name="DefaultRouteHost"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Как работают маршруты" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Через VPN — соединение идёт через выбранный сервер.&#10;&#10;Через zapret — трафик идёт напрямую с обработкой обхода. Это не меняет внешний IP.&#10;&#10;Напрямую — обход VPN. Фактическая обработка zapret зависит от активных фильтров winws." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Точный домен — только example.com. Домен и поддомены — example.com и *.example.com. IP / подсеть — один адрес или сеть с маской.&#10;&#10;Порядок меняется через правую кнопку мыши → «Выше / Ниже». Правила сохраняются для выбранного профиля. Для работающего профиля нажми «Применить правила»: это закроет текущие соединения." Style="{StaticResource MutedText}" Margin="0,16,0,0"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="ConnectionsPage" Visibility="Collapsed">
       <TextBlock Text="Соединения" Style="{StaticResource Heading}"/>
       <TextBlock Text="Данные работающего ядра. Нажми строку, чтобы сохранить правило для приложения, домена или IP." Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
       <TextBlock Text="Поиск по приложению, домену или IP" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
       <TextBox x:Name="ConnectionSearch" AutomationProperties.Name="Поиск соединений" TextChanged="ConnectionFilterChanged" Margin="0,0,0,16"/>
       <Border Style="{StaticResource Panel}" Padding="12"><StackPanel>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="235"/><ColumnDefinition Width="70"/><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Приложение" Style="{StaticResource MutedText}" Margin="10,0"/><TextBlock Grid.Column="1" Text="Назначение" Style="{StaticResource MutedText}" Margin="10,0"/><TextBlock Grid.Column="2" Text="Тип" Style="{StaticResource MutedText}" Margin="10,0"/><TextBlock Grid.Column="3" Text="Маршрут" Style="{StaticResource MutedText}" Margin="10,0"/><TextBlock Grid.Column="4" Text="Выбрано правилом" Style="{StaticResource MutedText}" Margin="10,0"/></Grid>
        <StackPanel x:Name="ConnectionRows"/>
       </StackPanel></Border>
       <Button Content="Применить правила (переподключение)" Click="ApplyRules" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock x:Name="ConnectionSummary" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
       <Border Style="{StaticResource Panel}" Margin="0,18,0,0"><TextBlock Text="В таблице показан маршрут, сообщённый ядром. Новые правила применяются при следующем подключении или по кнопке «Применить правила». Для Xray приложения и байты могут быть недоступны." Style="{StaticResource MutedText}"/></Border>
      </StackPanel>
      <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
       <TextBlock Text="Настройки" Style="{StaticResource Heading}"/><TextBlock Text="Повседневные действия — автоматически" Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
       <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Подключение" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="AutoServer" Content="Выбирать сервер при подключении" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/><CheckBox x:Name="AutoStrategy" Content="Подбирать стратегию zapret" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/><Button Content="Автозапуск Windows…" Click="OpenStartup" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
       <Border x:Name="StartupPanel" Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="Автозапуск Windows" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="StartupEnabled" Content="Запускать RelayDesk при входе в Windows"/><CheckBox x:Name="StartupVpn" Content="Автоматически включать VPN"/><CheckBox x:Name="StartupZapret" Content="Автоматически включать zapret"/><TextBlock Text="Профиль VPN" Style="{StaticResource MutedText}" Margin="0,12,0,6"/><ComboBox x:Name="StartupProfile" AutomationProperties.Name="Профиль VPN для автозапуска"/><Button Content="Сохранить автозапуск" Click="SaveModernStartup" HorizontalAlignment="Left" Margin="0,16,0,10"/><TextBlock x:Name="StartupMessage" Style="{StaticResource MutedText}"/><TextBlock Text="Запуск через 15 секунд после входа в Windows. Подключение — после появления сети. Задача Windows меняется только после сохранения." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Оформление и движение" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="MotionChoice" Content="Плавные анимации" IsChecked="True" Checked="MotionChanged" Unchecked="MotionChanged"/><CheckBox x:Name="CityMotionChoice" Content="Анимация ASCII-акул" IsChecked="True" Checked="CityMotionChanged" Unchecked="CityMotionChanged"/><CheckBox x:Name="GlassChoice" Content="Полупрозрачное стекло" IsChecked="True" Checked="GlassChanged" Unchecked="GlassChanged"/><TextBlock Text="Белые ASCII-акулы на чёрном фоне. Можно остановить фон отдельно от анимаций интерфейса. При сворачивании движение приостанавливается." Style="{StaticResource MutedText}"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Режим покоя" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="QuietChoice" Content="Гасить интерфейс, когда он не используется" Checked="QuietModeChanged" Unchecked="QuietModeChanged"/><TextBlock Text="Через 30 секунд без действий или при уходе из окна останутся только подключения и время работы ядер. Первый клик возвращает интерфейс и не нажимает кнопки." Style="{StaticResource MutedText}"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Значок в трее" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="TrayChoice" Content="Показывать RelayDesk в области уведомлений" Checked="TrayChoiceChanged" Unchecked="TrayChoiceChanged"/><TextBlock Text="Кнопка «Свернуть» скрывает окно в трей. Через значок можно управлять VPN и zapret, выбрать сервер и открыть правила. Кнопка «Закрыть» или «Выход» завершает RelayDesk и останавливает его ядра." Style="{StaticResource MutedText}"/></StackPanel></Border>
       <Button x:Name="AdvancedButton" Content="Расширенные настройки  ›" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ToggleAdvanced"/>
       <Border x:Name="AdvancedPanel" Style="{StaticResource Panel}" Margin="0,12,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="Все параметры профиля и программы" FontSize="19" FontWeight="SemiBold"/><Button Content="TUN, DNS, JSON, ядра и автоматика…" Click="OpenAdvanced" HorizontalAlignment="Left" Margin="0,12"/><Button Content="Обновления и журнал выпуска…" Click="OpenUpdates" HorizontalAlignment="Left"/><TextBlock Text="Сохранены прежний редактор JSON, импорт подписок, ядра, диагностика и автозапуск." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
      </StackPanel>
     </Grid></ScrollViewer>
     <Border Grid.Row="1" BorderBrush="#42554B" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0"><TextBlock x:Name="Notice" Text="Профили и настройки хранятся на этом компьютере." Style="{StaticResource MutedText}"/></Border>
    </Grid>
   </Grid>
   <Border Grid.Row="2" Background="#B00F1218" CornerRadius="0,0,12,12"><Grid Margin="22,0"><TextBlock x:Name="BuildVersion" FontSize="12" Foreground="#C9D1DE" VerticalAlignment="Center"/><TextBlock x:Name="MaterialLabel" Text="Белый ASCII · чёрный фон" FontSize="12" Foreground="#9098A6" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Border>
  <Grid x:Name="QuietOverlay" Visibility="Collapsed" Background="#08000000" WindowChrome.IsHitTestVisibleInChrome="True">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
    <StackPanel x:Name="QuietVpnRow" Margin="0,0,0,28"><TextBlock x:Name="QuietVpnTitle" Text="VPN" Foreground="#B4BDCD" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="QuietVpnTime" Text="00:00:00" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
    <StackPanel x:Name="QuietZapretRow" Margin="0,0,0,28"><TextBlock Text="zapret" Foreground="#B4BDCD" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="QuietZapretTime" Text="00:00:00" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
    <TextBlock x:Name="QuietOff" Text="Подключения выключены" FontSize="24" Foreground="#B4BDCD" HorizontalAlignment="Center" Margin="0,0,0,28"/>
    <TextBlock Text="Нажми, чтобы вернуться" Foreground="#7F899B" FontSize="13" HorizontalAlignment="Center"/>
   </StackPanel>
  </Grid></Grid>
</Window>
